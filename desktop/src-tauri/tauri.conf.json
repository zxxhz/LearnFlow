{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnFlow",
  "version": "0.1.0",
  "identifier": "com.learnflow.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LearnFlow",
        "url": "start.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
